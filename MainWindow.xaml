<Window x:Class="RevealLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevealLoader" Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Resources/icon.ico"
        Opacity="0"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <!-- Тонкая полоса прокрутки в тёмном стиле. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2b2b2b" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт бокового меню. -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="root" Background="{TemplateBinding Background}">
                            <Border x:Name="indicator" Width="3" Height="18" CornerRadius="2"
                                    Background="#ffffff" HorizontalAlignment="Left" Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="indicatorScale" ScaleY="1"/>
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#0d0d0d"/>
                                <Setter TargetName="indicator" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="indicatorScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.4" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка «свернуть». -->
        <Style x:Key="MinBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4d4d4d"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="&#x2014;" Foreground="{TemplateBinding Foreground}"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#141414"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка «закрыть». -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource MinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="&#x2715;" Foreground="{TemplateBinding Foreground}"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffffff"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка запуска. -->
        <Style x:Key="LaunchBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="16" Padding="0,16" SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#ffffff" Offset="0"/>
                                    <GradientStop Color="#d8d8d8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вторичная кнопка (белая, компактная). -->
        <Style x:Key="SolidBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="9" Background="#ffffff"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="solidScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <TextBlock x:Name="solidText" Text="{TemplateBinding Content}" Foreground="#000000"
                                       FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e2e2e2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="solidScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.015" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="solidScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.015" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="solidScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="solidScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#bfbfbf"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-«пилюля» для пресетов памяти. -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" Background="#111111" BorderBrush="#1e1e1e"
                                BorderThickness="1" CornerRadius="9">
                            <TextBlock x:Name="chipText" Text="{TemplateBinding Content}" Foreground="#8f8f8f"
                                       FontSize="12" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#161616"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="#ffffff"/>
                                <Setter TargetName="chipText" Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#ffffff"/>
                                <Setter TargetName="chipText" Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле ввода с подсветкой при фокусе. -->
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="#0f0f0f"/>
            <Setter Property="BorderBrush" Value="#1c1c1c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#3d3d3d"/>
                    <Setter Property="Background" Value="#131313"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Background="#000000" BorderBrush="#1c1c1c" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#050505" CornerRadius="18,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,16,0,0">
                        <Image x:Name="LogoImage" Source="Resources/logo.png" Width="40" Height="40"
                               HorizontalAlignment="Center" Opacity="0"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect Color="#ffffff" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>
                            </Image.Effect>
                        </Image>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <RadioButton Style="{StaticResource NavBtn}" x:Name="NavHome"
                                     IsChecked="True" Checked="NavHome_Checked">
                            <TextBlock Text="&#x2302;" x:Name="IconHome"
                                       Foreground="#ffffff" FontSize="19"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavBtn}" x:Name="NavSettings"
                                     Checked="NavSettings_Checked">
                            <TextBlock Text="&#x2699;" x:Name="IconSettings"
                                       Foreground="#4d4d4d" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="v1.0" Foreground="#242424" FontSize="10"
                               FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель -->
                <Grid Grid.Row="0" Background="Transparent" Margin="0,8,12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource MinBtn}" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource CloseBtn}" Click="CloseButton_Click" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Главная -->
                <Grid x:Name="HomePage" Grid.Row="1" Visibility="Visible">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Grid.RenderTransform>

                    <StackPanel VerticalAlignment="Center" Margin="56,0,56,30">

                        <TextBlock x:Name="WelcomeAccent" Text="RevealLoader"
                                   Foreground="#ffffff" FontSize="30" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                            <TextBlock x:Name="FreeText" Text="Free" Foreground="#454545" FontSize="12"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="  ·  " Foreground="#2c2c2c" FontSize="12" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="SymbolText" Text="Ꝏ" Foreground="#454545" FontSize="12"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Сводка по выделенной памяти и Java -->
                        <Border Background="#0a0a0a" BorderBrush="#191919" BorderThickness="1"
                                CornerRadius="14" Height="58" Margin="0,32,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <TextBlock x:Name="RamCaption" Text="ПАМЯТЬ" Foreground="#3f3f3f"
                                               FontSize="9" FontFamily="Consolas" FontWeight="Bold"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="RamSummaryText" Text="1 – 5 GB" Foreground="#d6d6d6"
                                               FontSize="13" FontFamily="Consolas"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#191919" Margin="0,15"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <TextBlock x:Name="JavaCaption" Text="JAVA" Foreground="#3f3f3f"
                                               FontSize="9" FontFamily="Consolas" FontWeight="Bold"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="JavaSummaryText" Text="Авто" Foreground="#d6d6d6"
                                               FontSize="13" FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Запуск -->
                        <Button x:Name="PlayButton" Style="{StaticResource LaunchBtn}"
                                Height="58" Margin="0,24,0,0" Click="PlayButton_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="#ffffff" BlurRadius="28" ShadowDepth="0" Opacity="0.15"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25B6;" Foreground="#000000" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,1,10,0" Opacity="0.75"/>
                                <TextBlock x:Name="LaunchText" Text="ЗАПУСК" Foreground="#000000"
                                           FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Переключатель языка -->
                        <Border x:Name="LangSwitch" Width="272" Height="46" Background="#0a0a0a"
                                BorderBrush="#191919" BorderThickness="1" CornerRadius="13"
                                Padding="4" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="LangHighlight" Grid.Column="0" Background="#ffffff"
                                        CornerRadius="10">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                </Border>

                                <Border x:Name="LangRuBtn" Grid.Column="0" Background="Transparent"
                                        Cursor="Hand" MouseLeftButtonDown="LangRu_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Image x:Name="ImgRu" Source="Resources/ru.png" Width="18" Height="18"
                                               Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="LabelRu" Text="Русский" Foreground="#000000"
                                                   FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="LangEnBtn" Grid.Column="1" Background="Transparent"
                                        Cursor="Hand" MouseLeftButtonDown="LangEn_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Image x:Name="ImgEn" Source="Resources/uk.png" Width="18" Height="18"
                                               Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="LabelEn" Text="English" Foreground="#8a8a8a"
                                                   FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Статус -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Border x:Name="StatusDot" Width="6" Height="6" CornerRadius="3" Background="#ffffff"
                                    Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="#4a4a4a"
                                       FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Настройки -->
                <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SettingsTitle" Text="Настройки" Foreground="#ffffff"
                               FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI"
                               Margin="52,10,52,22"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel Margin="52,0,40,30" MaxWidth="620" HorizontalAlignment="Left">

                            <!-- Java -->
                            <TextBlock x:Name="JavaLabel" Text="JAVA" Foreground="#4a4a4a" FontSize="10"
                                       FontFamily="Consolas" FontWeight="Bold" Margin="2,0,0,10"/>
                            <Border Background="#0a0a0a" BorderBrush="#191919" BorderThickness="1"
                                    CornerRadius="14" Margin="0,0,0,10">
                                <Grid Height="50">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource FieldBox}"
                                            BorderThickness="0" Background="Transparent" CornerRadius="14,0,0,14">
                                        <TextBox x:Name="JavaPathBox" Background="Transparent" Foreground="#8a8a8a"
                                                 BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                                 Padding="18,0" VerticalContentAlignment="Center"
                                                 IsReadOnly="True"/>
                                    </Border>

                                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="…"
                                            Width="54" Margin="6" Style="{StaticResource SolidBtn}"
                                            Click="BrowseJava_Click"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="JavaHintText" Text="Укажите javaw.exe для запуска"
                                       Foreground="#333333" FontSize="10" FontFamily="Segoe UI"
                                       Margin="4,0,0,26"/>

                            <!-- Память -->
                            <TextBlock x:Name="MemoryLabel" Text="ПАМЯТЬ" Foreground="#4a4a4a" FontSize="10"
                                       FontFamily="Consolas" FontWeight="Bold" Margin="2,0,0,10"/>
                            <Border Background="#0a0a0a" BorderBrush="#191919" BorderThickness="1"
                                    CornerRadius="14" Padding="18,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="MinText" Text="МИН" Foreground="#3f3f3f"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                       Margin="2,0,0,8"/>
                                            <Border Style="{StaticResource FieldBox}" Height="42">
                                                <TextBox x:Name="RamMinBox" Background="Transparent"
                                                         Foreground="#ffffff" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="15" FontWeight="Light"
                                                         Padding="12,0" VerticalContentAlignment="Center"
                                                         MaxLength="6"
                                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                                         TextChanged="RamInput_TextChanged"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="–" Foreground="#2f2f2f" FontSize="17"
                                                   FontWeight="Light" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MaxText" Text="МАКС" Foreground="#3f3f3f"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                       Margin="2,0,0,8"/>
                                            <Border Style="{StaticResource FieldBox}" Height="42">
                                                <TextBox x:Name="RamMaxBox" Background="Transparent"
                                                         Foreground="#ffffff" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="15" FontWeight="Light"
                                                         Padding="12,0" VerticalContentAlignment="Center"
                                                         MaxLength="6"
                                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                                         TextChanged="RamInput_TextChanged"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#151515" Margin="0,18,0,16"/>

                                    <TextBlock x:Name="PresetsLabel" Text="БЫСТРЫЙ ВЫБОР" Foreground="#3f3f3f"
                                               FontSize="10" FontFamily="Consolas" FontWeight="Bold"
                                               Margin="2,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="2 GB" Tag="2048"
                                                Style="{StaticResource ChipBtn}" Click="RamPreset_Click"/>
                                        <Button Grid.Column="2" Content="4 GB" Tag="4096"
                                                Style="{StaticResource ChipBtn}" Click="RamPreset_Click"/>
                                        <Button Grid.Column="4" Content="8 GB" Tag="8192"
                                                Style="{StaticResource ChipBtn}" Click="RamPreset_Click"/>
                                        <Button Grid.Column="6" Content="16 GB" Tag="16384"
                                                Style="{StaticResource ChipBtn}" Click="RamPreset_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="RamHintText" Text="Рекомендуется не менее 5 ГБ"
                                               Foreground="#333333" FontSize="10" FontFamily="Segoe UI"
                                               Margin="2,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Сохранить -->
                            <Button x:Name="SaveBtn" Content="СОХРАНИТЬ" Margin="0,26,0,0" Height="46"
                                    Style="{StaticResource SolidBtn}" Click="SaveSettings_Click"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
